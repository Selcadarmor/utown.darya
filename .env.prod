# Данные MySQL с Railway
JAVA_TOOL_OPTIONS=-Xmx256m -Xms128m

# MySQL DataSource
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://containers-us-west-99.railway.app:3306/railway?allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8&sslMode=DISABLED
spring.datasource.username=root
spring.datasource.password=kBiomzVGHogxeYXmIoNhAaJhrUJxCFkA

# Flyway
spring.flyway.url=jdbc:mysql://containers-us-west-99.railway.app:3306/railway?allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8&sslMode=DISABLED
spring.flyway.user=root
spring.flyway.password=kBiomzVGHogxeYXmIoNhAaJhrUJxCFkA
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true


# JWT configuration (use 256-bit minimum secure keys)
JWT_ACCESS_SECRET=REMOVED
JWT_REFRESH_SECRET=REMOVED
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS
