# Данные MySQL с Railway
JAVA_TOOL_OPTIONS=-Xmx256m -Xms128m

# MySQL DataSource
MYSQLUSER=root
MYSQLPASSWORD=kBiomzVGHogxeYXmIoNhAaJhrUJxCFkA
MYSQLDATABASE=railway
MYSQLHOST=switchback.proxy.rlwy.net
MYSQLPORT=51560

# Flyway
spring.flyway.url=jdbc:mysql://${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8&sslMode=DISABLED
spring.flyway.user=${MYSQLUSER}
spring.flyway.password=${MYSQLPASSWORD}
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true


# JWT configuration (use 256-bit minimum secure keys)
JWT_ACCESS_SECRET=REMOVED
JWT_REFRESH_SECRET=REMOVED
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=selcadarmor
AWS_ACCESS_KEY=REMOVED
AWS_SECRET_KEY=REMOVED

# Активируем production профиль
SPRING_PROFILES_ACTIVE=prod